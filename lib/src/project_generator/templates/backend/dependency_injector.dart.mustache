import 'dart:async';
import 'package:eloquent/eloquent.dart';
import 'package:get_it/get_it.dart';

import '../db/database_service.dart';
{{{imports}}}

final ioc = GetIt.instance;
const requestConnectionZoneKey = #accessToDartRequestConnection;

void setupDependencies() {
  if (!ioc.isRegistered<DatabaseService>()) {
    ioc.registerSingleton<DatabaseService>(DatabaseService());
  }

  if (!ioc.isRegistered<Connection>()) {
    ioc.registerFactory<Connection>(() {
      final connection = Zone.current[requestConnectionZoneKey];
      if (connection is! Connection) {
        throw StateError('Database connection requested outside an API request');
      }
      return connection;
    });
  }

  void regFactoryIfAbs<T extends Object>(T Function() factory) {
    if (!ioc.isRegistered<T>()) {
      ioc.registerFactory<T>(factory);
    }
  }

{{{factories}}}
}
