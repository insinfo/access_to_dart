  Future<List<Map<String, dynamic>>> lookupOptions({
    required String sourceTable,
    String? joinTable,
    String? joinLeft,
    String? joinRight,
    String? filterColumn,
    String? filterValue,
    required String valueColumn,
    required String labelColumn,
    String? orderByColumn,
    List<String> projectionColumns = const [],
    int limit = 100,
  }) async {
    final query = db.table(sourceTable).whereNotNull('$sourceTable.$valueColumn');
    if (joinTable != null) {
      query.join(joinTable, joinLeft!, '=', joinRight!);
    }
    if (filterColumn != null) {
      final quoted = query.getGrammar().wrap(filterColumn);
      query.whereRaw('LOWER($quoted) = LOWER(?)', [filterValue]);
    }
    query.select(['$sourceTable.$valueColumn AS lookup_value', '$sourceTable.$labelColumn AS lookup_label',
      for (var i = 0; i < projectionColumns.length; i++) '$sourceTable.${projectionColumns[i]} AS lookup_column_$i']);
    if (orderByColumn != null && orderByColumn.isNotEmpty) {
      query.orderBy('$sourceTable.$orderByColumn');
    }
    final rows = List<Map<String, dynamic>>.from(await query.limit(limit).get());
    return rows
        .map(
          (row) => <String, dynamic>{
            if (projectionColumns.isNotEmpty) 'columns': [for (var i = 0; i < projectionColumns.length; i++) row['lookup_column_$i']],
            'value': row['lookup_value'],
            'label': row['lookup_label'] ?? row['lookup_value'],
          },
        )
        .toList(growable: false);
  }

