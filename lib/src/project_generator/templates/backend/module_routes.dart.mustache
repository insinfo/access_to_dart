import 'package:shelf_router/shelf_router.dart';
import '../controllers/{{normalizedName}}_controller.dart';
import '../../../shared/access_subforms.dart';
import '../../../shared/access_multivalues.dart';

void setup{{className}}Routes(Router app, String basePath) {
  final group = Router()
    ..get('/', {{className}}Controller.list)
    ..get('/lookups/<fieldKey>', {{className}}Controller.lookup)
    ..get('/<id>', {{className}}Controller.show)
    ..get('/<id>/subforms/<key>', (request, id, key) =>
        AccessSubformController.list(request, '{{routeName}}', id, key))
    ..post('/<id>/subforms/<key>', (request, id, key) =>
        AccessSubformController.create(request, '{{routeName}}', id, key))
    ..delete('/<id>/subforms/<key>/<childId>', (request, id, key, childId) =>
        AccessSubformController.delete(request, '{{routeName}}', id, key, childId))
    ..get('/<id>/collections/<fieldKey>', (request, id, fieldKey) =>
        AccessMultivalueController.list(request, '{{routeName}}', id, fieldKey))
    ..put('/<id>/collections/<fieldKey>', (request, id, fieldKey) =>
        AccessMultivalueController.replace(request, '{{routeName}}', id, fieldKey))
    ..get('/<id>/attachments/<fieldKey>', {{className}}Controller.attachments)
    ..post('/<id>/attachments/<fieldKey>', {{className}}Controller.createAttachment)
    ..delete('/<id>/attachments/<fieldKey>/<ordinal>', {{className}}Controller.deleteAttachment)
    ..post('/', {{className}}Controller.create)
    ..put('/<id>', {{className}}Controller.update)
    ..delete('/<id>', {{className}}Controller.delete);

  app.mount('$basePath/{{routeName}}', group.call);
}
